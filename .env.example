PORT=3007
HOST=127.0.0.1

# Lark app credentials: https://open.larksuite.com/app → your app →
# "Credentials & Basic Info". (Feishu/China: https://open.feishu.cn/app)
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret
# "lark" for international Lark, "feishu" for Feishu (China).
LARK_DOMAIN=lark

# Private key your own agent/scripts use to call /lark/send. Don't share it.
AGENT_API_KEY=replace_with_a_long_random_string

# Groq (OpenAI-compatible). Create a key at https://console.groq.com/keys
MODEL_API_KEY=your_groq_api_key
MODEL_API_URL=https://api.groq.com/openai/v1/chat/completions
MODEL_NAME=openai/gpt-oss-120b

# Pricing rules the agent must follow (Indian rupees per piece).
PRODUCT_NAME=leather products
STANDARD_UNIT_PRICE=250
BULK_MINIMUM_QUANTITY=500
MINIMUM_UNIT_PRICE=225
