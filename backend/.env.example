PORT=3007
HOST=127.0.0.1

# Lark app credentials: https://open.larksuite.com/app → your app →
# "Credentials & Basic Info". (Feishu/China: https://open.feishu.cn/app)
LARK_APP_ID=your_lark_app_id
LARK_APP_SECRET=your_lark_app_secret
# "lark" for international Lark, "feishu" for Feishu (China).
LARK_DOMAIN=lark

# Private key your own agent/scripts use to call /lark/send. Don't share it.
AGENT_API_KEY=replace_with_a_long_random_string

# Groq (OpenAI-compatible). Create a key at https://console.groq.com/keys
MODEL_API_KEY=your_groq_api_key
MODEL_API_URL=https://api.groq.com/openai/v1/chat/completions
MODEL_NAME=openai/gpt-oss-120b

# Pricing rules the agent must follow (Indian rupees per piece).
PRODUCT_NAME=leather products
STANDARD_UNIT_PRICE=250
BULK_MINIMUM_QUANTITY=500
MINIMUM_UNIT_PRICE=225

# Redis: Celery broker + customers + conversation cache + reminders (required).
# docker compose sets this for you; on Render it comes from the lark-redis Key Value service.
REDIS_URL=redis://127.0.0.1:6379/0

# Dashboard origins allowed to call this API (comma-separated, no trailing slash):
CORS_ORIGINS=http://localhost:5310
# "off" = don't open the Lark long connection (e.g. while Render is running the real bot).
# LARK_LISTENER=off
# Flower password (docker compose; on Render it's generated).
# FLOWER_PASSWORD=admin

# ---- Better Stack (optional). One Logs source per stream; each pair is off while empty. ----
# Better Stack → Telemetry → Sources → Connect source → Python → copy "Source token" and "Ingesting host".
# Application: bot replies, AI calls (tokens/cost), Lark sends, customers
BETTERSTACK_APP_TOKEN=
BETTERSTACK_APP_HOST=
# Celery: worker + Beat, reminders scheduled/sent/failed/cancelled
BETTERSTACK_CELERY_TOKEN=
BETTERSTACK_CELERY_HOST=
# Redis: connections, errors, stats every minute (memory, clients, ops/s, hit rate, queue length)
BETTERSTACK_REDIS_TOKEN=
BETTERSTACK_REDIS_HOST=
# Server: uvicorn HTTP access + server logs
BETTERSTACK_SERVER_TOKEN=
BETTERSTACK_SERVER_HOST=
# Errors: Better Stack → Errors → your application → DSN (Sentry-compatible).
BETTERSTACK_ERRORS_DSN=
